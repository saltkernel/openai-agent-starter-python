# ============ 对话模型（必填）============
# 变量名优先读 LLM_*：EdgeOne Makers 沙箱会预置同名 AI_GATEWAY_*（平台内置网关），
# 线上没有 .env 时读到的是平台网关键 → 401 auth_failed "Invalid API key"。
# 生产环境请把这三项配到 Makers 控制台「环境变量」页，然后重新部署（热改无效）。
LLM_API_KEY=your-api-key
LLM_BASE_URL=https://open.bigmodel.cn/api/paas/v4
LLM_MODEL=glm-4.7-flash

# 兼容旧变量名：仅在 LLM_* 缺失时回退，本地已有 .env 不必改名
AI_GATEWAY_API_KEY=
AI_GATEWAY_BASE_URL=
AI_GATEWAY_MODEL=@makers/deepseek-v4-flash

# ============ 向量模型（全文入库 / 混合检索必需）============
# 必须输出 1024 维；换模型需清空向量库重建（直接删 data/store.sqlite）
EMBEDDING_API_KEY=your-embedding-key
EMBEDDING_BASE_URL=https://api.siliconflow.cn/v1
EMBEDDING_MODEL=BAAI/bge-m3

# ============ 论文数据源 ============
# Semantic Scholar：可留空，留空走共享池（易 429，代码已自动退避 + OpenAlex 兜底）
S2_API_KEY=
# OpenAlex 礼貌池，填邮箱即可（建议 edu 邮箱）
OPENALEX_MAILTO=you@example.edu.cn
# Unpaywall 取开放获取 PDF 直链，必须是真实邮箱
UNPAYWALL_EMAIL=you@example.edu.cn

# ============ 本地向量库落地文件 ============
# 相对路径以仓库根目录为基准；沙箱重启不丢
VECTOR_STORE_PATH=./data/store.sqlite
